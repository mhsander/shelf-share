{
  "expo": {
    "name": "Shelf Share",
    "slug": "shelf-share",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shelfshare",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.martola.shelfshare", // <-- ADDED THIS
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.martola.shelfshare",
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to scan the barcodes on your books.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin", // <-- ADDED IF USING GOOGLE SIGNIN
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR-IOS-CLIENT-ID-PREFIX"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0579a216-b940-4ea4-9cc6-275261dda00d"
      }
    }
  }
}
